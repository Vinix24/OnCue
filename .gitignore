# Environment
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/

# Release artifacts (built by scripts/build_release.sh)
dist/
.venv/
venv/

# Data (local databases, session reports, transcripts, logs) — never commit
data/*
!data/samples/
!data/samples/**

# VNX orchestration layer — dev-scaffolding, geen product. Blijft lokaal, gaat niet mee.
.vnx/
.vnx-version
.vnx-project-id
.claude/vnx-system
.claude/skills/intelligence-engineer/
.claude/skills/t0-orchestrator/
.claude/skills/vnx-manager/
.claude/skills/horizon/

# Pre-cutover backups + skills-backup + lokale Claude Code sessie-state (lokaal)
*.pre-cutover-*
.claude/skills.bak.*
.claude/projects/

# AudioTee binary is a build artefact (compiled locally by scripts/setup.sh /
# scripts/install.sh from the OSS-vendored Swift source in vendor/audiotee/);
# never commit the compiled binary itself.
bin/audiotee
bin/
vendor/audiotee/.build/

# Node modules (Reveal.js)
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Models (downloaded at runtime)
models/
.vnx-data/
.vnx-data.pre-retirement-*/
.agents/
.gemini/

# MCP credentials per terminal (contain secrets)
.claude/terminals/*/.mcp.json
.mcp.json

# Pytest
.pytest_cache/

# Hygiene — backup files, editor logs, temp captures
*.bak-*
excalidraw.log
.env.verify*
data/tmp/

# Internal working docs — not for OSS distribution (stays on disk, untracked)
claudedocs/

# Built artifacts — regenerated, not source
scripts/launcher/*.app/
scripts/launcher/icon/*
!scripts/launcher/icon/generate_icon.py
sbom.json

# Personal/throwaway analysis scripts — not product code
scripts/_analyse_time_investment.py

# VNX T0: ignore local working files + derived role files; track ONLY the two
# source files (CLAUDE.md thin pointer + project-context.md). role-orchestrator.md /
# AGENTS.md / GEMINI.md are regenerated by `vnx role sync` and stay ignored.
.claude/terminals/**
!.claude/terminals/*/
!.claude/terminals/*/CLAUDE.md
!.claude/terminals/*/project-context.md

# Fabric-scaffolding skills (VNX/Claude Code werkomgeving, geen product)
.claude/skills/control-centre/
.claude/skills/fabric-reference/
.claude/skills/featureplan-kickoff/
.claude/skills/pm/
