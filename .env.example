# ============================================================
# ONCUE — CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required: at least one LLM API key (or Ollama running locally)
# Everything else has sensible defaults.
# ============================================================

# --- Language / i18n ----------------------------------------
# Product/UI language. Selects the user-facing message catalog
# (config/i18n/<lang>.yaml) and the coaching-prompt + transcription-vocabulary
# routing in the lang_router. Supported catalogs: nl (default) | en.
# A missing catalog or key falls back to nl, so a partial translation is safe.
# nl is de default voor de Nederlandstalige pilot; bij de internationale
# OSS-launch gaat dit terug naar en.
# This is separate from CALL_LANGUAGE below, which is the spoken language passed
# to the transcriber and detector routes.
LANGUAGE=nl

# --- LLM Provider -------------------------------------------
# Which LLM to use for pain point confirmation.
# Options: gemini | vertex | groq | openai | azure | ollama | openrouter
# Default: gemini / gemini-2.5-flash — free tier (get a key at
# https://aistudio.google.com/app/apikey), fast, and the provider every install doc
# walks you through. Swap LLM_PROVIDER to any option above; openrouter with a paid
# anthropic/claude-haiku-4.5 model is a higher-quality opt-in alternative (set
# OPENROUTER_API_KEY below).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
# Hard SDK-level ceiling on the escalation-LLM call — a circuit breaker against a hung
# request, not the live 5s-to-screen SLA target itself (that budget spans VAD + Whisper +
# routing + this call + render; see scripts/e2e_latency_harness.py). At 7000ms this sits
# comfortably above the p95 of the cloud providers (gemini/openai/groq/openrouter — a
# few seconds) without truncating real generations.
# For LLM_PROVIDER=ollama a hard floor of 90000ms is enforced regardless of this value —
# local models run cold in up to ~70s, so a 7s timeout would silently fail every summary.
LLM_TIMEOUT_MS=7000
# Stream the user-facing generations (suggestions + dynamic slides) so first tokens hit the
# screen in ~1-2s instead of waiting for the full structured object. Default ON for the pilot.
# Detection (llm_confirm's pain-point gate) never streams — it has no user-facing text.
# gemini/vertex always fall back to non-streaming regardless of this flag. Set to false to
# force every generation back onto the non-streaming acreate() path.
LLM_STREAMING=true
# Marks the stable system-prompt prefix (instructions + any uploaded context docs) as an
# Anthropic prompt-cache breakpoint so repeat calls on the same LLMClient don't re-process it.
# Only applies to LLM_PROVIDER=openrouter with an anthropic/... LLM_MODEL — cleanly skipped
# everywhere else (gemini/vertex use a different caching mechanism; other providers have no
# equivalent wire field). Default ON; caching is transparent to output either way.
LLM_PROMPT_CACHE=true
# PII redaction policy before text is sent to an LLM provider. Three values:
#   cloud_only (default) — redact before public cloud (gemini/groq/openai); pass raw only to
#                          a local Ollama loopback or a trusted BYO-tenant (azure/vertex +
#                          TRUST_OWN_TENANT). Safe default.
#   always               — redact before EVERY provider (compliance mode).
#   off                  — never redact (explicit operator opt-out). A skipped redaction is
#                          always logged once per process, never silent.
PII_REDACTION=cloud_only
# Legacy global raw-override. Truthy forces PII_REDACTION=off (kept for backward compat).
# Keep false to redact names, email, phone, BSN, IBAN and dates.
ALLOW_RAW_LLM_PII=false
# BYO-tenant PII opt-out. Only takes effect with LLM_PROVIDER=azure or vertex.
# When true, PII redaction is skipped because inference stays inside your own cloud
# tenant under your own DPA. Leave false unless you have that agreement in place.
# Has no effect on public providers (gemini/groq/openai) or on the hardcoded-cloud
# post-processing scripts (e.g. scripts/label_and_summarize.py).
TRUST_OWN_TENANT=false

# API keys — set the one matching your LLM_PROVIDER
# OpenRouter API key (from https://openrouter.ai/keys) — required only if you set
# LLM_PROVIDER=openrouter (e.g. LLM_MODEL=anthropic/claude-haiku-4.5). Routes through
# OpenRouter's public API, not the direct Anthropic API — no Anthropic SDK involved.
OPENROUTER_API_KEY=
# Your Google Gemini API key (from https://aistudio.google.com/app/apikey)
# Also read as GOOGLE_API_KEY - either var name works, GEMINI_API_KEY preferred
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# For local models via Ollama
# Must include /v1 — the OpenAI-compatible adapter POSTs to <base>/v1/chat/completions.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Ollama API-sleutel (optioneel — alleen nodig bij Ollama met auth-proxy)
OLLAMA_API_KEY=
# Context window (in tokens) for ollama structured-output calls. Ollama's own runtime
# default is 4096 regardless of the model's trained max — too small for a thinking-capable
# local model's reasoning trace plus a long transcript plus an instructor retry-replay, which
# silently truncates the JSON output before it validates. The client bakes this into a
# derived model (Ollama's OpenAI-compatible endpoint ignores num_ctx passed as a request
# param) named "<model>-numctx<N>", created once per process via `POST /api/create`.
# Raise only up to the selected model's trained max context.
OLLAMA_NUM_CTX=32768

# Azure OpenAI (BYO-tenant) — inference stays inside the customer's own Azure tenant.
# Set LLM_PROVIDER=azure and LLM_MODEL=<your-deployment-name> (not the model name).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-TENANT.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Audio Capture ------------------------------------------
# How to capture system audio from video conferencing apps.
# Options: audiotee (default on macOS) | blackhole | mic | wasapi (default on Windows)
# - audiotee (default on macOS): Core Audio process-tap on the whole
#   system-output mix (tap_all), not a single targeted app. Meeting audio
#   (Google Meet-in-Chrome, Teams, Zoom) is rendered by helper subprocesses,
#   so a single-process tap would miss it -- the whole-mix tap sidesteps
#   that entirely and needs no meeting-app detection. Needs the macOS
#   process-tap permission (System Settings > Privacy & Security >
#   Audio-opname / Audio Recording on macOS 14.4+); the copilot warns with
#   instructions if that permission is missing instead of failing silently.
#   The telephony daemon (avconferenced, phone/FaceTime-relay calls) is
#   excluded from this tap in the free tier -- that's the Sales Pro gate
#   (PROSPECT_SOURCE=audiotee_call below), not a hard capability limit.
# - blackhole: manual fallback, not an automatic one -- the copilot never
#   switches to it on its own. Choose this explicitly if AudioTee's
#   process-tap permission isn't available (macOS <14.4) or you prefer the
#   classic virtual-device routing. Requires the macOS "BlackHole 2ch"
#   virtual device plus a manual Multi-Output Device routing in Audio MIDI
#   Setup — not something a non-technical user can complete unassisted,
#   which is exactly why this is no longer the default.
# - mic: mic-only, no prospect stream (self-transcript / talk-time only).
# - wasapi: Windows loopback capture (whole-endpoint, requires `pip install
#   ".[windows]"`). This is the Windows default — leave unset on Windows and
#   the copilot picks it automatically. A headset is required: WASAPI
#   loopback captures everything the system plays, so speakers cause
#   echo/self-capture. macOS/Linux normalize an explicit "wasapi" back to
#   "audiotee".
# - replay: dev/testing only — replay a recorded session directory
#   (REPLAY_SESSION_DIR below, holding self.wav + prospect.wav, 16 kHz mono)
#   through the full live pipeline instead of capturing real hardware. No mic
#   or meeting app is touched. Use scripts/replay_session.py to run it.
# Leave unset (default): audiotee on macOS/Linux, wasapi on Windows -- see
# _load_audio_config()'s platform_default. A shipped literal "audiotee" here
# would override that Windows auto-detection for anyone who copies this file
# as-is without editing it.
AUDIO_CAPTURE_METHOD=
# Windows only (AUDIO_CAPTURE_METHOD=wasapi): pin the loopback tap to a
# specific playback endpoint instead of following whatever Windows currently
# calls the default. Matches case-insensitively by substring against the
# device name (e.g. "Realtek" or "Headset" is enough, no need for the full
# driver-qualified name Windows reports). Leave empty (default) to follow the
# system default output device -- the copilot re-attaches automatically if
# that default changes mid-call (device plugged in, output switched). When
# set but no endpoint matches, the copilot warns once and falls back to the
# default device instead of failing the call; a pinned, matched override is
# never displaced by a later default-device change.
AUDIO_WASAPI_ENDPOINT_NAME=
# Recorded session directory for AUDIO_CAPTURE_METHOD=replay. Must contain
# self.wav (the rep) and prospect.wav (the prospect). Leave empty otherwise.
REPLAY_SESSION_DIR=
# Playback speed multiplier for replay mode: 1.0 = real-time, 2.0 = 2x.
REPLAY_SPEED=1.0
# Has no effect on the live-call AudioTee tap above: with
# AUDIO_CAPTURE_METHOD=audiotee the prospect stream always captures the
# whole system-output mix (tap_all) regardless of this value. Only internal
# debug/experiment tooling (scripts/experiment_call_tap.py) reads it. Leave
# empty.
TARGET_PROCESS_NAME=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
# Optional dedicated input mic name or numeric device index. This lets you use
# a USB/lavalier mic for input while keeping Bluetooth headphones as output.
MIC_INPUT_DEVICE=
# On macOS this binary is built locally from the OSS-vendored Swift source at
# vendor/audiotee/ by scripts/setup.sh / scripts/install.sh — no manual build step.
AUDIOTEE_BINARY_PATH=./bin/audiotee

# Prospect-stream routing gate, independent of AUDIO_CAPTURE_METHOD above.
# Options:
#   blackhole      (default) — historical name; does NOT force the BlackHole
#                               device. Uses whatever AUDIO_CAPTURE_METHOD
#                               says (audiotee tap_all, blackhole, mic, or
#                               wasapi).
#   audiotee_call             — Sales Pro only. Prospect via a process-tap on
#                               the telephony daemon, for phone calls
#                               (iPhone-relay/FaceTime audio) that bypass
#                               virtual audio devices entirely. A Bluetooth
#                               headset is fine in this mode. Not available
#                               on Windows (no telephony-daemon equivalent) --
#                               normalizes to "blackhole" there. Can also be
#                               set per call via the start_call config field
#                               `prospect_source`.
# See docs/SETUP_EXPECTATIONS.md section "Telefoongesprekken (iPhone-relay)".
PROSPECT_SOURCE=blackhole
# Process the call-tap follows when PROSPECT_SOURCE=audiotee_call.
# avconferenced is the macOS telephony daemon behind FaceTime/Phone-relay.
# macOS only -- has no effect on Windows (see PROSPECT_SOURCE above).
CALL_PROCESS_NAME=avconferenced

# --- Transcription ------------------------------------------
# Real-time speech-to-text engine.
# Engine mode (how audio is streamed to the backend):
# - direct (default): low-latency streaming engine with Silero VAD gating.
#   Runs whichever WHISPER_BACKEND you select below.
# - whisper.cpp: forces the whisper.cpp binary + GGML model path regardless
#   of WHISPER_BACKEND.
TRANSCRIPTION_ENGINE=direct
# Transcription backend.
# - whisper.cpp (default): stable, on-device, built by scripts/install.sh.
# - mlx-whisper (experimental): Apple Silicon native. Known issue — the live
#   path may silently deliver zero segments; switch back to whisper.cpp if you
#   hit silent transcription.
# - parakeet (optional, Apple Silicon): NVIDIA Parakeet on MLX. Multilingual TDT
#   model mlx-community/parakeet-tdt-0.6b-v3 (25 EU languages incl. Dutch) with
#   finer streaming granularity. Needs the optional extra + ffmpeg on PATH:
#       pip install '.[parakeet]'   (ffmpeg via Homebrew: brew install ffmpeg)
# - groq (CLOUD, opt-in): Groq's whisper-large-v3-turbo API. ~5x faster than local
#   whisper.cpp at comparable NL quality, but every audio chunk leaves the machine
#   as a WAV upload to Groq — never the default, not for gevoelige gesprekken.
#   Requires GROQ_API_KEY (see API keys section above).
WHISPER_BACKEND=whisper.cpp
# Default: large-v3-turbo (~800 MB, ~1.6 GB RAM, 5s warmup, ~50% faster per chunk
# than large-v3 with +0.5pp WER NL — negligible). Use large-v3 only if you need
# the absolute best accuracy and can spend ~3 GB RAM and 30s warmup.
# This value is the live default. For post-call transcription, use a heavier
# model per run via `--model` on scripts/transcribe_file.py without changing
# this value.
WHISPER_MODEL=large-v3-turbo
# Per-call default language for detector routes and transcription.
# Supported: nl | en | de
CALL_LANGUAGE=nl
# Optional explicit Whisper override. When unset, this follows CALL_LANGUAGE.
WHISPER_LANGUAGE=nl
WHISPER_CPP_BINARY=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL_PATH=./vendor/whisper.cpp/models/ggml-large-v3-turbo.bin
WHISPER_CPP_CHUNK_MS=3000
WHISPER_CPP_THREADS=4
# Hard wall-clock bound per whisper.cpp transcription. A chunk that exceeds this
# is dropped (empty transcript) instead of stalling the engine.
WHISPER_CPP_TIMEOUT_S=30
# Persistent whisper-server fast path. Keeps the model resident so each chunk
# skips the ~1.6GB reload that one-shot whisper-cli pays. Set to false to force
# the one-shot CLI path. The backend auto-falls-back to CLI if the server cannot
# start or a request fails.
WHISPER_CPP_SERVER_ENABLED=true
WHISPER_CPP_SERVER_BINARY=./vendor/whisper.cpp/build/bin/whisper-server
# Host the whisper-server binds to/is reached at. Override for a split deploy
# (e.g. Mac captures audio, a remote box like a DGX Spark runs inference) by
# pointing this at the remote host's address.
WHISPER_CPP_SERVER_HOST=127.0.0.1
# 0 = pick a free ephemeral port (recommended). Set a fixed port only if needed.
WHISPER_CPP_SERVER_PORT=0
WHISPER_CPP_SERVER_STARTUP_TIMEOUT_S=60
# Continuous-buffer segmentation (AudioBufferer, shared-queue path). Audio is
# buffered continuously from speech onset to flush -- including sub-VAD dips --
# instead of only VAD-positive frames, which is what caused onset-clipped,
# discontinuous audio to reach Whisper and hallucinate (often in English on
# Dutch input). VAD only marks segment boundaries; it never decides which
# samples are kept.
#
# Soft cap: during a long monologue, flush at the first real pause (>=300ms)
# after this many seconds so a mid-monologue objection is not stuck behind an
# unbroken segment. A genuinely continuous utterance with zero pauses is not
# split here -- only the hard cap below chops it.
WHISPER_MAX_BUFFER_SECONDS=4.0
# Hard cap: flush even mid-speech once a segment reaches this length, so a
# true unbroken monologue still gets bounded-latency partial transcripts.
WHISPER_MAX_BUFFER_HARD_SECONDS=7.0
# Flush after this much trailing silence so completed phrases appear quickly.
WHISPER_SILENCE_GAP_SECONDS=1.0
# Hard floor: below this, a segment is never sent to Whisper on its own (sub-
# second fragments are the dominant hallucination source). Short utterances
# are carried forward into the next segment instead of being dropped.
WHISPER_MIN_SEGMENT_SECONDS=1.2
# Escape hatch: flush a still-sub-floor segment anyway after this much
# silence, so a short "nee"/"te duur" is not held forever waiting to reach
# WHISPER_MIN_SEGMENT_SECONDS. The downstream filler-filter drops junk.
WHISPER_LONG_SILENCE_ESCAPE_SECONDS=2.5
# Rolling pre-roll prepended on speech onset so the first word is not clipped
# by the VAD's reaction delay.
WHISPER_PRE_ROLL_MS=500
# Hangover kept after a low-VAD chunk before the utterance is considered
# ended, so a brief inter-syllable dip does not truncate the segment.
WHISPER_HANGOVER_MS=250
# Turn hand-off flush: when the other speaker (self vs. prospect) has held the
# floor continuously for this long, flush this speaker's in-progress segment
# instead of waiting for silence_gap. Guards against a quick backchannel
# ("ja", "hm", "oke") on the other stream falsely ending this speaker's turn.
WHISPER_TURN_BACKCHANNEL_GUARD_MS=700
# Pre-load the Whisper model at backend startup instead of on the first
# Start Call event. Trade-off: slower process startup (~5-15s extra) but the
# first call begins instantly with no warmup delay. Set true if you want the
# transcriber daemon hot before the operator clicks Start Call.
WHISPER_EAGER_WARMUP=false
WHISPER_FINE_TUNED_MODEL_PATH=

# Optional local vocabulary / hotword biasing (NO fine-tuning required).
# The configured YAML is rendered into Whisper's `initial_prompt` to steer the
# model toward Dutch B2B terms (company names, sales jargon, pain points).
# Works for whisper.cpp and mlx-whisper; parakeet does not support prompt biasing.
WHISPER_VOCABULARY_CONFIG=config/transcription_vocabulary.yaml
WHISPER_VOCABULARY_ENABLED=true
# Optional override: provide an explicit prompt string instead of the YAML list.
# WHISPER_VOCABULARY_INITIAL_PROMPT=

DIARIZATION_BACKEND=sortformer
# In BlackHole single-stream fallback (no separate mic stream), map all speech to this speaker.
# Options: prospect | self
SINGLE_STREAM_SPEAKER_DEFAULT=prospect
MIN_SPEAKERS=2
MAX_SPEAKERS=2
WHISPER_PORT_MIC=8761
WHISPER_PORT_SYSTEM=8761
# Backward-compatible alias for the mic stream if older scripts still read WHISPER_PORT.
WHISPER_PORT=8761
# Shared inference queue: single backend instance fed by both audio streams via a priority queue.
# true (default) = prospect chunks (HIGH) drain before self chunks (LOW), eliminates backend races.
# false = legacy dual-engine path with one backend per stream.
TRANSCRIBER_SHARED_QUEUE=true
# Maximum items held in the shared queue before backpressure drops the oldest LOW-priority item.
TRANSCRIBER_QUEUE_MAX_SIZE=32
# Priority of the self/operator mic stream: low (default) = prospect always goes first.
# Set to equal if you want both streams to share the same priority lane.
TRANSCRIBER_SELF_PRIORITY=low
# Show your own (mic) transcript live during the call.
# Default false: only prospect appears live; your transcript is added
# post-call via batch transcription on the recorded mic audio.
# Set to true to see your own text live (more GPU pressure on mlx).
TRANSCRIBE_SELF_LIVE=false
# Drop noisy one-letter artifacts (e.g. "K") before publishing transcript events.
TRANSCRIPT_DROP_SINGLE_CHAR_ALPHA=true
# Ignore ultra-short interim/partial chunks.
TRANSCRIPT_MIN_PARTIAL_CHARS=2

# --- Local persistence --------------------------------------
# Audio recording is opt-in. Transcripts/reports remain local and can be purged
# with scripts/purge_session.py.
RECORD_AUDIO=false
AUDIO_RECORDER_FLUSH_SECONDS=5.0

# --- Compliance ---------------------------------------------
# Data retention: auto-purge sessions older than N days (0 = disabled).
# Enforced at orchestrator startup (a non-blocking sweep) and by
# scripts/retention_purge.py (run via cron). When 0 and old data exists, a single
# WARNING is logged so a default install knows nothing is being auto-purged.
DATA_RETENTION_DAYS=0
# Record a non-blocking consent flag per session in the audit trail.
CONSENT_TRACKING_ENABLED=true
# Configurable consent-strength tier. The deploying organisation (AVG controller)
# chooses the strictness; the strictest option exists but is not forced.
#   off    — no consent gate (available, not recommended; logs a startup warning).
#   audit  — record asked/given when the start-call payload carries it; DEFAULT.
#            The session always proceeds. This is the responsible default.
#   soft   — if no consent is recorded, show a non-blocking dashboard nudge;
#            the session still proceeds.
#   strict — refuse to start until consent is explicitly given (given=true).
#            Use this for recruitment and other high-compliance scenarios.
CONSENT_TIER=audit
# Deprecated alias for CONSENT_TIER. Kept for backward compatibility:
#   audit    -> CONSENT_TIER=audit
#   blocking -> CONSENT_TIER=strict
# If CONSENT_TIER is set, CONSENT_GATE_MODE is ignored.
# CONSENT_GATE_MODE=audit
#
# Per-preset defaults (env always wins):
#   sales/coach/acquisitie -> audit
#   recruitment            -> strict
# Override per deployment by setting CONSENT_TIER in this file.

# --- Runtime auto-arm (Pro, video calls + phone/FaceTime calls) ----------------
# When a supported video meeting app (Google Chrome / Microsoft Teams / zoom.us)
# becomes active, or macOS reports an active phone/FaceTime call via the
# avconferenced daemon (Continuity/iPhone-relay), Pro installs can automatically
# surface a consent-tick prompt and arm the session -- this never starts
# recording silently; the user still has to explicitly confirm. Distinct from
# the launch-at-login autostart step in the setup wizard. See docs/FEATURES.md.
AUTOSTART_MONITOR_ENABLED=true
# Seconds between detection polls (both trigger sources are polled every cycle).
AUTOSTART_POLL_INTERVAL_S=2.0
# Consecutive present/absent polls required before arming/disarming, so a
# flapping or transient process presence never repeatedly triggers a prompt.
# Shared by both trigger sources -- there is no separate telephony debounce knob.
AUTOSTART_DEBOUNCE_ARM_POLLS=2
AUTOSTART_DEBOUNCE_DISARM_POLLS=2

# --- Pain Point Detection -----------------------------------
# Embedding model for fast classification (runs locally).
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Confidence thresholds:
# >= HIGH: trigger immediately (no LLM needed)
# >= LOW and < HIGH: send to LLM for confirmation
# < LOW: ignore
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_LOW=0.50

# Seconds to wait before re-triggering the same pain point category
DEBOUNCE_SECONDS=45

# Enable automatic phase detection (discovery/pitch/closing) from transcript.
AUTO_PHASE_DETECTION=false

# Path to pain point route definitions
PAIN_POINTS_CONFIG=config/pain_points.yaml
OBJECTIONS_CONFIG=config/objections.yaml
OPPORTUNITIES_CONFIG=config/opportunities.yaml
NEGATIVES_CONFIG=config/negatives.yaml
# Include opportunity/readiness routes in the ObjectionRouter (structural precision fix).
# Default true: eval showed this cuts false-positive objections on readiness/interest
# utterances (seedset 10 -> 6) while keeping price/budget objection recall at 1.0.
INCLUDE_OPPORTUNITIES=true
# Include a real negative/"none" class in the ObjectionRouter (structural precision
# fix #2). Default true: generic non-objection prospect speech (rambling, questions,
# backchannel) competes for the best match instead of being forced into the closest
# objection category. See scripts/eval_objection_precision.py for before/after precision.
INCLUDE_NEGATIVES=true
OBJECTION_RESPONSES_CONFIG=config/objection_responses.yaml
# All four AI features are ON by default in v1.0+. Set to false to disable.
ENABLE_OBJECTION_DETECTION=true

# Only classify prospect speech (ignore salesperson)
ONLY_CLASSIFY_PROSPECT=true

# --- Sliding-Window Detector --------------------------------
# Number of prospect transcript chunks to keep in the window
DETECTOR_WINDOW_SIZE=5
# Minimum chunks before the window is classified (avoids classifying micro-fragments)
DETECTOR_MIN_CHUNKS=3
# Seconds to wait before re-classifying the same window (debounce)
DETECTOR_DEBOUNCE_S=5.0

# Real-time follow-up question suggestions for the salesperson.
ENABLE_SUGGESTIONS=true

# Optional 60-second summary feed for the dashboard.
ENABLE_SUMMARY=true

# --- Deep Insight Lane (Track 3, Pro) ------------------------
# Minutes-latency companion to the detector above: reads the FULL running
# transcript plus prep-docs and issues one heavy-thinking LLM call per
# interval. Off by default; requires FEATURE_DEEP_INSIGHTS entitlement.
INSIGHT_ENABLED=false

# Seconds between deep-insight cycles. A cycle only runs an LLM call when new
# prospect text has arrived since the last one.
INSIGHT_INTERVAL_S=90

# Provider/model for the deep lane, separate from LLM_PROVIDER/LLM_MODEL above
# so it can be routed to a frontier/BYO-tenant destination while the fast
# detector stays local. Leave empty to fall back to LLM_PROVIDER/LLM_MODEL.
INSIGHT_PROVIDER=
INSIGHT_MODEL=

# Request timeout for one deep-insight LLM call (heavier thinking budget than
# the detector's LLM_TIMEOUT_MS, so it needs more headroom).
INSIGHT_LLM_TIMEOUT_MS=60000

# Character cap for prep-docs loaded into the deep-lane prompt (higher than
# the detector's default 4,000-char context-doc cap).
INSIGHT_MAX_CONTEXT_CHARS=16000

# Hard cap on deep-insight LLM calls per call session. On reaching the cap the
# engine stops calling the LLM and publishes exactly one notice on the
# "insights" channel.
INSIGHT_MAX_CALLS_PER_SESSION=30

# Reasoning-budget passed to the thinking-capable model for each deep-insight
# call (see core/thinking_policy.py).
INSIGHT_REASONING_BUDGET=8192

# When true (default, as long as the lane itself is on), a fresh named entity
# in prospect speech (a product/system/company name not seen before this
# session -- the "Lime CRM" moment) triggers an immediate insight cycle
# instead of waiting for the next INSIGHT_INTERVAL_S tick. Each entity fires
# at most once per session; the call still counts against
# INSIGHT_MAX_CALLS_PER_SESSION.
INSIGHT_ENTITY_TRIGGER_ENABLED=true

# Cap on how many previously-dismissed insights/hints (feedback_store,
# data/feedback/hints.ndjson) are included as "do not repeat" context in each
# deep-insight prompt. Keeps the negative-context block bounded as the
# feedback file grows across sessions.
INSIGHT_NEGATIVE_FEEDBACK_LIMIT=20

# When true (default, as long as the lane itself is on), the persistent
# seller profile (data/profile/profile.md -- "what I already know, what I
# sell, my method", edited via the wizard) is loaded into every deep-insight
# prompt so the engine skips basic explanations the seller already knows.
PROFILE_ENABLED=true

# Character cap for the seller profile when loaded into the deep-lane prompt.
INSIGHT_PROFILE_MAX_CHARS=4000

# Character cap for the client dossier (earlier transcripts/notes from
# data/clients/<slug>/) loaded into the deep-lane prompt, when a session is
# explicitly linked to a client (opt-in per session, no default link). Oldest
# material is dropped first when the cap is exceeded.
INSIGHT_DOSSIER_MAX_CHARS=8000

# When true, a session's transcript is copied into its linked client's
# dossier folder (data/clients/<slug>/) after the call, so the dossier grows
# organically. Default false -- requires both this flag AND a client link for
# that specific session (set at session start); neither alone saves anything.
DOSSIER_AUTO_SAVE=false

# --- MCP Bridge (Track 3, Pro) --------------------------------
# Exposes three read-only MCP tools (get_session_brief, get_transcript,
# get_detections) plus one write-back tool (push_insight) over JSON-RPC stdio
# so an MCP host (Claude Desktop/Code or any other host) can act as the
# reasoning engine during a call. Pro-tier only (requires FEATURE_MCP_BRIDGE
# entitlement); the server refuses to start on Free. Default false -- turn on
# explicitly when you want to connect an MCP host. Every read-only tool
# output passes through core/outbound_policy.py (cloud_only PII redaction)
# before it reaches the MCP host. push_insight is the reverse direction
# (host -> local) so it is not PII-redacted, but it is validated and capped.
MCP_BRIDGE_ENABLED=false

# Hard cap on push_insight calls per MCP bridge session, to guard the
# dashboard's insights feed against a misbehaving or runaway MCP host.
MCP_BRIDGE_MAX_PUSHED_INSIGHTS_PER_SESSION=50

# --- Audit Backend ------------------------------------------
# Waar audit-events worden opgeslagen.
# Opties: ndjson (standaard, lokaal) | supabase (cloud)
# Vereist: SUPABASE_URL + SUPABASE_KEY bij supabase
AUDIT_BACKEND=ndjson

# Supabase audit-backend (optioneel — alleen bij AUDIT_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# --- Case Database ------------------------------------------
# Where case studies are stored.
# Options: sqlite (local, default) | supabase (cloud)
CASE_DB_TYPE=sqlite
CASE_DB_SQLITE_PATH=data/cases.db

# Supabase settings (only if CASE_DB_TYPE=supabase)
CASE_DB_URL=
CASE_DB_KEY=

# Pre-set prospect industry for better case matching (optional)
# Options: manufacturing | services | retail | tech | finance | healthcare
PROSPECT_INDUSTRY=

# --- Talk Time Coaching -------------------------------------
# Rolling window for "current pace" indicator
ROLLING_WINDOW_SECONDS=120

# Alert after this many seconds of uninterrupted speaking
MONOLOGUE_WARNING_SECONDS=76

# Target talk-time ratio per conversation phase (percentage for salesperson)
DISCOVERY_TARGET_SELF=0.35
PITCH_TARGET_SELF=0.65
CLOSING_TARGET_SELF=0.45

# How far off-target before color changes
RATIO_AMBER_THRESHOLD=0.05
RATIO_RED_THRESHOLD=0.10

# UI update frequencies
COACHING_UPDATE_INTERVAL_MS=5000
PERCENTAGE_UPDATE_INTERVAL_MS=15000
# Dashboard heartbeat for talk-time snapshots (emits while call is active)
TALK_TIME_HEARTBEAT_MS=1000

# VAD tuning to prevent silence/system-noise from counting as speech
VAD_POSITIVE_THRESHOLD_SELF=0.5
VAD_NEGATIVE_THRESHOLD_SELF=0.35
VAD_POSITIVE_THRESHOLD_PROSPECT=0.62
VAD_NEGATIVE_THRESHOLD_PROSPECT=0.45
VAD_MIN_RMS_SELF=0.004
VAD_MIN_RMS_PROSPECT=0.008
VAD_DEBOUNCE_MS=300

# --- Audio tap diagnosability -------------------------------
# Telling "the tap never opened" apart from "the tap is open and the source is
# silent". Both produce no transcript and no error; they need opposite fixes.
#
# Digital-silence floor on the float32 [-1, 1] scale. This is NOT a speech
# threshold (that is VAD_MIN_RMS_* above, sixteen times higher): it only decides
# whether a delivered frame is anything other than zeros, so a soft talker still
# counts as a working tap. Same value check_device_health uses.
AUDIO_TAP_SIGNAL_FLOOR_RMS=0.0005
# How often the transcriber logs one INFO line per stream with the tap verdict
# and its counters. Proof of life during a call without raising LOG_LEVEL.
AUDIO_TAP_HEARTBEAT_SECONDS=30
# An open tap that has delivered zero frames for this long is a fault: an open
# Core Audio tap keeps pushing buffers whether or not anything plays through it.
AUDIO_TAP_NO_FRAMES_WARN_SECONDS=10
# An open tap whose frames are all digital silence AND that has never carried a
# single audible frame this call warns after this long. The "never once" part is
# what keeps an ordinary pause in a conversation from ever triggering it: one
# audible frame disarms this warning for the rest of the session.
AUDIO_TAP_SILENT_WARN_SECONDS=120
# A tap that DID carry audio this call and then delivers nothing but bit-for-bit
# zero samples for this long has lost its source, and the operator is warned plus
# a marker is written into the transcript. This is not a silence threshold: an
# ordinary pause carries a noise floor, and one non-zero sample resets the run.
# 30 seconds only decides how much audio is lost before you hear about it.
AUDIO_TAP_SIGNAL_LOST_WARN_SECONDS=30

# --- Presentation -------------------------------------------
# Reveal.js settings
REVEAL_WS_PORT=8765
REVEAL_TRANSITION=slide
PRESENTATION_PATH=presentation/index.html
# Controls the LLM-generated slide path within the Pro-gated injector.
# In-call slide injection (presentation.dynamic_slides) requires a Pro license —
# this variable has no effect on Free. When Pro is active: true = generate a slide
# via LLM when no pre-authored case matches; false = skip injection on no-match.
DYNAMIC_SLIDES=true

# --- WebSocket Hub ------------------------------------------
# Central message broker (always localhost)
WS_HUB_HOST=127.0.0.1
WS_HUB_PORT=8760

# --- Preset -------------------------------------------------
# Gesprekstype bepaalt welke pain points, objections en coaching-targets geladen worden.
# Opties: sales (standaard) | coach | recruitment
PRESET=sales

# --- Post-Call Reports --------------------------------------
# The local report is always written to data/reports/ and that path is not
# configurable. To send the transcript somewhere else, use the
# REPORT_DELIVERY_* settings further down; those are the ones a downstream
# automation hooks into.
# Redact PII (prospect name/company + transcript text) in the on-disk post-call
# report. Default off: the local report is owner-only (0600) and the unredacted
# transcript is the operator's useful record. Set true for compliance-strict
# deployments. Mirrors the PII_REDACTION LLM-mode philosophy. Also governs
# anything sent via REPORT_DELIVERY_* below -- there is no separate redaction
# toggle for delivery.
REPORT_REDACT_PII=false

# --- Report Delivery (customer-configured trigger, optional) -------
# Full contract: docs/MODULE4.md ("Report Delivery"). Both sinks are optional,
# independent, and OFF by default -- unset, a fresh install only ever writes
# the local data/reports/ copy above, exactly as before.
#
# A directory (including a mounted network share) that receives an atomic copy
# of every report under the same filename as the local report.
# REPORT_DELIVERY_DIR=/Volumes/shared/oncue-reports
#
# An http(s) endpoint that receives one POST per report (Content-Type: application/json,
# body = the report JSON verbatim). Embed a shared secret in the URL itself if the
# endpoint needs auth (e.g. an n8n webhook token) -- this is not a webhook framework.
# Pro/Enterprise only: on a Free license this endpoint is configured but not
# delivered to -- the directory sink above still runs.
# REPORT_DELIVERY_ENDPOINT=https://n8n.example.com/webhook/your-token
REPORT_DELIVERY_TIMEOUT_S=10.0
REPORT_DELIVERY_MAX_ATTEMPTS=3
REPORT_DELIVERY_RETRY_BACKOFF_S=2.0

# --- Speaker Diarization (optional) -------------------------
# Multi-speaker support via pyannote/speaker-diarization-3.1
# Requires: HuggingFace account + accepted model card on hf.co
# Commercial use: contact gabriel.huang@hi-paris.fr before production release
# (see claudedocs/ADR-PYANNOTE-DIARIZATION.md — licensing section)
HUGGINGFACE_TOKEN=hf_PLACEHOLDER
# Set to 1 to enable diarization. Default 0 = shadow-mode (no diarization at all).
# With 0: transcript pipeline is completely unchanged.
# With 1: speaker_segments WS events emitted alongside transcript; detector unaffected.
DIARIZATION_ENABLED=0
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=10

# --- License Gate -------------------------------------------
# Your Pro license key. Empty = free tier (14-day grace, then free features only).
# Production keys are Ed25519-signed (SCP-...) and issued by the license server
# after purchase. Set the key here to unlock Pro features (telephony capture,
# central compliance-audit).
SALES_COPILOT_LICENSE=
# License server base URL — used for the revocation check and the central
# compliance-audit ingest. Default when unset: https://license.salescopilot.app
# SALES_COPILOT_LICENSE_CHECK_URL=https://license.salescopilot.app
# Dev-build only (no effect on a packaged/release build): on a dev checkout,
# current_tier() already defaults to unconditional "enterprise" (full access,
# no license needed) — you do not need to set this for normal local use. It
# exists only to force a specific tier while testing tier-specific behaviour
# locally: "free" / "pro" / "enterprise" forces that tier; "license" disables
# the admin override entirely and falls back to the real license flow above
# (SALES_COPILOT_LICENSE + revocation check), so the license chain itself can
# be exercised from a dev checkout.
# SALES_COPILOT_DEV_TIER=
# Legacy only: shared HMAC-SHA256 secret to validate old SC- keys until the
# 2026-09-01 migration deadline. New installs leave this empty. It is no longer
# produced by scripts/generate_secrets.py — a shared secret enabled self-minting.
SALES_COPILOT_LICENSE_SECRET=

# --- Sample Aha Demo ----------------------------------------
# Curated transcript sample played by the "Toon me wat het doet" button.
# No microphone, no Whisper model and no LLM key are required.
SAMPLE_AHA_PATH=data/samples/sample-aha.json
SAMPLE_AHA_SPEED=1.5

# --- Measurement / Launch-funnel signals (all OFF by default) ---
# Opt-in only. All signals are privacy-safe: no PII, no transcript, no raw
# license key leaves the machine. Hardcoded endpoints are forbidden.
#
# Send aggregated, PII-stripped correction counts when a user marks a detection
# as wrong. Payload: {event_type, predicted_counts, corrected_counts, ts,
# install_code, license_fingerprint}.
MEASUREMENT_CORRECTION_OPT_IN=false
# MEASUREMENT_CORRECTION_ENDPOINT=https://license.salescopilot.app/measurement/correction
#
# Periodically ping while a valid Pro license is active. Payload contains only
# license_fingerprint + timestamp + install_code.
MEASUREMENT_HEARTBEAT_ENABLED=false
# MEASUREMENT_HEARTBEAT_ENDPOINT=https://license.salescopilot.app/measurement/heartbeat
MEASUREMENT_HEARTBEAT_INTERVAL_S=3600
#
# Install / attribution code. Captured in the local audit trail at intake.
# Leave empty if not used; empty is allowed but logged as a warning.
INSTALL_CODE=

# --- Security Tokens ----------------------------------------
# Token required by the dashboard to call mutating API endpoints (start-call,
# end-call, shutdown, upload, sample-aha). Generate with: python scripts/generate_secrets.py
SHUTDOWN_TOKEN=
